# Register a dedicated OAuth App with no additional permission scopes.
# Hosted callback: https://connecting-coders.prismiwi.workers.dev/api/github/auth/callback
# For localhost, use a separate OAuth App and matching GITHUB_APP_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable across deployments.
GITHUB_SESSION_KEY=
GITHUB_APP_URL=http://localhost:5175
